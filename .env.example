# --- Database (Postgres) -------------------------------------------------
DATABASE_URL=postgres://redrope:redrope@localhost:5432/redrope
# DATABASE_SSL=true

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that are granted the admin role on first login.
ADMIN_EMAILS=admin@redrope.local

# --- Email (magic links, customer updates) ----------------------------------
# console | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Red Rope <hello@redrope.local>"

# --- AI (Anthropic) ---------------------------------------------------------
# When unset, the concierge falls back to a deterministic rule-based parser and
# AI drafting features return templated drafts instead of model output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Payments (Stripe) ------------------------------------------------------
# When unset, deposit collection is disabled in the UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
